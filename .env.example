# For development, the browser and desktop app load http://localhost:5173.
# For production, set this to the public HTTPS URL and NODE_ENV=production.
PUBLIC_ORIGIN=http://localhost:5173
HOST=127.0.0.1
PORT=4310
DATABASE_PATH=data/stage.db

# Blank means forwarding headers are not trusted. For a reverse proxy, list only
# its exact source IP as Stage sees it (possibly the Docker bridge gateway).
# Comma-separated IPv4/IPv6 literals only; no ranges, hostnames, or "true".
# The proxy must overwrite client-supplied forwarding headers, and the backend
# port must remain private so requests cannot bypass that proxy.
TRUSTED_PROXY_IPS=

# Team-wide credential issuance attempts per minute, in addition to 12 per
# login session. This in-memory single-server limit resets on restart.
# It is NOT a spending or active-stream cap: audio streams directly to Soniox.
TEAM_TOKEN_LIMIT_PER_MINUTE=60

# Set a long shared code (16+ characters recommended).
# On loopback only, leaving it empty generates a private code file in data/.
TEAM_ACCESS_CODE=

# Server credential only. Never bundle this into the desktop app.
SONIOX_API_KEY=
# global, eu, or jp. Regional projects need matching Soniox access and credentials.
SONIOX_REGION=global

# Optional desktop process environment override (not a server .env setting).
# Packaged apps normally ask for the team server address on first launch.
# STAGE_SERVER_URL=https://captions.example.com

{
  "name": "stage-captions",
  "version": "0.1.6",
  "private": true,
  "description": "English and Japanese live captions for team presentations",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "desktop": "electron .",
    "test": "node --import tsx --test tests/client/*.test.ts tests/server/*.test.mjs tests/desktop/*.test.cjs",
    "check": "npm run build && npm test",
    "package:desktop": "electron-builder --config electron-builder.config.cjs",
    "desktop:package": "npm run package:desktop",
    "test:desktop": "node --test tests/desktop/*.test.cjs",
    "desktop:preview": "electron scripts/preview-desktop.cjs"
  },
  "dependencies": {
    "@soniox/client": "^2.3.0",
    "express": "^5.2.1",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.5.1",
    "electron-builder": "26.15.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "overrides": {
    "app-builder-lib": {
      "@electron/get": "5.1.0"
    }
  }
}
